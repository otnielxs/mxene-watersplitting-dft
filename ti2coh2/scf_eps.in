&CONTROL
  calculation = 'scf'
  prefix = 'ti2coh2_eps'
  outdir = './tmp'
  pseudo_dir = '../pseudopotential'
  nstep = 250
/

&SYSTEM
  ibrav = 0
  nat = 7
  ntyp = 4
  ecutwfc = 40
  ecutrho = 320
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.02
/

&ELECTRONS
  conv_thr = 1.0d-8
/

&IONS
/

CELL_PARAMETERS angstrom
  3.04823   0.00000   0.00000
 -1.52412   2.63985   0.00000
  0.00000   0.00000  23.78628

ATOMIC_SPECIES
 Ti 47.867 Ti.upf
 C  12.011 C.upf
 O  15.999 O.upf
 H   1.008 H.upf

ATOMIC_POSITIONS angstrom
! coordinate after relax.in optimized
K_POINTS automatic
 6 6 1 0 0 0
