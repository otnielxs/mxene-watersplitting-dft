&CONTROL
  calculation = 'nscf'
  prefix = 'ti2coh2'
  outdir = './tmp'
  pseudo_dir = '../pseudopotential'
  nstep = 250
/

&SYSTEM
  ibrav = 0
  nat = 7
  ntyp = 4
  nbnd = 50
  ecutwfc = 40
  ecutrho = 320
  occupations = 'fixed'
/

&ELECTRONS
  conv_thr = 1.0d-8
/

&IONS
/

CELL_PARAMETERS angstrom
  3.04823   0.00000   0.00000
 -1.52412   2.63985   0.00000
  0.00000   0.00000  23.78628

ATOMIC_SPECIES
 Ti 47.867 Ti.pbe-spn-kjpaw_psl.1.0.0.UPF
 C  12.011 C.pbe-n-kjpaw_psl.1.0.0.UPF
 O  15.999 O.pbe-n-kjpaw_psl.1.0.0.UPF
 H   1.008 H.pbe-kjpaw_psl.1.0.0.UPF 

ATOMIC_POSITIONS angstrom
! coordinate after relax.in optimized
K_POINTS automatic
 8 8 1 0 0 0
