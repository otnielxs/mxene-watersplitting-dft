&CONTROL
  calculation = 'nscf'
  prefix = 'ti2cf2_eps'
  outdir = './tmp'
  pseudo_dir = '../pseudopotential'
  nstep = 250
/

&SYSTEM
  ibrav = 0
  nat = 5
  ntyp = 3
  nbnd = 80
  ecutwfc = 40
  ecutrho = 320
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.02
  nosym = .true.
  noinv = .true.
/

&ELECTRONS
  conv_thr = 1.0d-8
/

&IONS
/

