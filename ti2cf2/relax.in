&CONTROL
  calculation = 'relax'
  prefix = 'ti2cf2'
  outdir = './tmp'
  pseudo_dir = '../pseudopotential'
  nstep = 250
/

&SYSTEM
  ibrav = 0
  nat = 5
  ntyp = 3
  ecutwfc = 40
  ecutrho = 320
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.02
/

&ELECTRONS
  conv_thr = 1.0d-8
/

&IONS
/

CELL_PARAMETERS angstrom
  3.04823   0.00000   0.00000
 -1.52412   2.63985   0.00000
  0.00000   0.00000  21.78628

ATOMIC_SPECIES
 Ti 47.867 Ti.pbe-spn-kjpaw_psl.1.0.0.UPF
 C  12.011 C.pbe-n-kjpaw_psl.1.0.0.UPF
 F  18.998 F.pbe-n-kjpaw_psl.1.0.0.UPF
ATOMIC_POSITIONS angstrom
Ti   0.00000   1.75990   1.75148
Ti   1.52412   0.87995   4.03480
 C   0.00000   0.00000   2.89314
 F   0.00000   1.75990   5.29386
 F   1.52412   0.87995   0.49242
K_POINTS automatic
 4 4 1 0 0 0
