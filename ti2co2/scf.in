&CONTROL
  calculation = 'scf'
  prefix = 'ti2co2'
  outdir = './tmp'
  pseudo_dir = '../pseudopotential'
  nstep = 250
/

&SYSTEM
  ibrav = 0
  nat = 5
  ntyp = 3
  ecutwfc = 40
  ecutrho = 320
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.02
/

&ELECTRONS
  conv_thr = 1.0d-8
/

&IONS
/

