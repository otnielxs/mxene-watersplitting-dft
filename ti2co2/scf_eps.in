&CONTROL
  calculation = 'scf'
  prefix = 'ti2co2_eps'
  outdir = './tmp'
  pseudo_dir = '../pseudopotential'
  nstep = 250
/

&SYSTEM
  ibrav = 0
  nat = 5
  ntyp = 3
  ecutwfc = 40
  ecutrho = 320
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.02
  nosym = .true.
  noinv = .true.
/

&ELECTRONS
  conv_thr = 1.0d-8
/

&IONS
/

CELL_PARAMETERS angstrom
  3.03214   0.00000   0.00000
 -1.51607   2.62591   0.00000
  0.00000   0.00000  21.42568

ATOMIC_SPECIES
 Ti 47.867 Ti.upf
 C  12.011 C.upf
 O  15.999 O.upf

ATOMIC_POSITIONS angstrom
! coordinate after relax.in optimized
K_POINTS automatic
 6 6 1 0 0 0
